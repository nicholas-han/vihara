# Copy to the repo root .env (gitignored) and replace these example paths.
# Use absolute paths, quoted because directory names can contain spaces.
VIHARA_DATA_DIR="/absolute/path/to/Vihara Archive"
PORTFOLIO_HOLDINGS_DB_PATH="/absolute/path/to/Vihara Archive/data/holdings.sqlite3"
INSTRUMENTS_DIR="/absolute/path/to/Vihara Archive/references/holdings"

# Current Holdings never uses the legacy PORTFOLIO_DB_PATH.
